# Local development. Copy to .env and fill in.
# In production these are set as environment variables on the host.

PORT=3000

# MongoDB connection string. Locally this can be a local mongod; in
# production it is the MongoDB Atlas cluster URI.
MONGO_URI=mongodb://localhost:27017/celicatesen

# Signs and verifies the admin session tokens. There is no default: the
# server refuses to start without it. Use a long random string.
JWT_SECRET=

# Comma-separated list of origins allowed to call the API. Leave empty to
# allow any origin, which is only sensible while developing.
CORS_ORIGIN=

# Only read by `npm run seed`, to create the single admin account.
ADMIN_NAME=Agustin
ADMIN_EMAIL=
ADMIN_PASSWORD=
